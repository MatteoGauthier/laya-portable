{
  "name": "laya-js-check",
  "private": true,
  "type": "module",
  "exports": {
    "./laya": "./laya.ts",
    "./preprocess": "./laya-preprocess.ts",
    "./postprocess": "./laya-postprocess.ts",
    "./action": "./laya-action.ts",
    "./bpe": "./laya-bpe.ts",
    "./feed": "./laya-feed.ts",
    "./errors": "./laya-errors.ts",
    "./types": "./laya-types.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check:bpe": "node check-bpe.ts",
    "check:bpe-fuzz": "node check-bpe-fuzz.ts",
    "check:tokenizer": "node check-tokenizer.ts",
    "check:split": "node check-split.ts",
    "check:node": "node run-node.ts",
    "check:versions": "node check-versions.ts",
    "check": "npm run check:bpe && npm run check:bpe-fuzz && npm run check:split",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "onnxruntime-web": "1.30.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "onnxruntime-web": "1.30.0",
    "onnxruntime-common": "1.30.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "laya": "./cli.ts"
  },
  "description": "Portable Laya runtime: BPE tokenizer, ONNX decisions, calibration (Node.js + TypeScript)"
}
