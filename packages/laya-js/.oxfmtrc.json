{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "tokenizer/",
    "fixtures/",
    "bpe-fuzz.json",
    "act_head.json",
    "act_head.bin",
    "act_head.meta.json",
    "web-test/",
    "dist/",
    "*.log",
    "package-lock.json"
  ]
}
